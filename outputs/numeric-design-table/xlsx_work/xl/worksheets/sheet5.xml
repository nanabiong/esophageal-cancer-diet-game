<?xml version="1.0" encoding="UTF-8" standalone="yes"?><worksheet xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships"><sheetViews><sheetView showGridLines="1" workbookViewId="0"><pane ySplit="1" topLeftCell="A2" activePane="bottomLeft" state="frozen"/></sheetView></sheetViews><sheetFormatPr defaultRowHeight="18"/><cols><col min="1" max="1" width="24" customWidth="1"/><col min="2" max="2" width="34" customWidth="1"/><col min="3" max="3" width="34" customWidth="1"/><col min="4" max="4" width="24" customWidth="1"/><col min="5" max="5" width="24" customWidth="1"/><col min="6" max="6" width="28" customWidth="1"/></cols><sheetData><row r="1" ht="28" customHeight="1"><c r="A1" t="inlineStr" s="2"><is><t xml:space="preserve">阶段</t></is></c><c r="B1" t="inlineStr" s="2"><is><t xml:space="preserve">函数/位置</t></is></c><c r="C1" t="inlineStr" s="2"><is><t xml:space="preserve">输入</t></is></c><c r="D1" t="inlineStr" s="2"><is><t xml:space="preserve">算法/公式</t></is></c><c r="E1" t="inlineStr" s="2"><is><t xml:space="preserve">输出字段</t></is></c><c r="F1" t="inlineStr" s="2"><is><t xml:space="preserve">备注</t></is></c></row><row r="2" ht="34" customHeight="1"><c r="A2" t="inlineStr" s="1"><is><t xml:space="preserve">1. 标准化输入</t></is></c><c r="B2" t="inlineStr" s="1"><is><t xml:space="preserve">normalizePlayerChoicesForRisk()</t></is></c><c r="C2" t="inlineStr" s="1"><is><t xml:space="preserve">playerChoices[]</t></is></c><c r="D2" t="inlineStr" s="1"><is><t xml:space="preserve">按 stepId 找早餐、速度、午餐、地点、火锅、饮品、省份记录；ID 转成 optionKey</t></is></c><c r="E2" t="inlineStr" s="1"><is><t xml:space="preserve">selectedItems</t></is></c><c r="F2" t="inlineStr" s="1"><is><t xml:space="preserve">数组输入走此路径；对象输入走 normalizeRiskInput()</t></is></c></row><row r="3" ht="50" customHeight="1"><c r="A3" t="inlineStr" s="1"><is><t xml:space="preserve">2. 行为归一化</t></is></c><c r="B3" t="inlineStr" s="1"><is><t xml:space="preserve">normalizeRiskBehavior()</t></is></c><c r="C3" t="inlineStr" s="1"><is><t xml:space="preserve">elapsedMs/clickCount/eatingSpeedLevel/lunchPlace</t></is></c><c r="D3" t="inlineStr" s="1"><is><t xml:space="preserve">clickSpeed = clickCount / (eatingDurationMs / 1000)；office_desk =&gt; irregular；有地点默认 regular</t></is></c><c r="E3" t="inlineStr" s="1"><is><t xml:space="preserve">behavior</t></is></c><c r="F3" t="inlineStr" s="1"><is><t xml:space="preserve">行为数据展示在数据弹窗，目前只影响标签收集中的 breakfastSpeed 和 regularity 展示</t></is></c></row><row r="4" ht="50" customHeight="1"><c r="A4" t="inlineStr" s="1"><is><t xml:space="preserve">3. 收集标签</t></is></c><c r="B4" t="inlineStr" s="1"><is><t xml:space="preserve">collectSelectedRiskTags()</t></is></c><c r="C4" t="inlineStr" s="1"><is><t xml:space="preserve">selectedItems</t></is></c><c r="D4" t="inlineStr" s="1"><is><t xml:space="preserve">早餐 + 早餐速度 + 午餐菜 + 午餐地点 + 火锅食物 + 火锅锅底 + 饮品 的 OPTION_RISK_TAGS 依次展开</t></is></c><c r="E4" t="inlineStr" s="1"><is><t xml:space="preserve">riskTag list</t></is></c><c r="F4" t="inlineStr" s="1"><is><t xml:space="preserve">空标签和无效标签过滤；未知标签记录 unknownRiskTags</t></is></c></row><row r="5" ht="34" customHeight="1"><c r="A5" t="inlineStr" s="1"><is><t xml:space="preserve">4. 标签计数</t></is></c><c r="B5" t="inlineStr" s="1"><is><t xml:space="preserve">calculatePlayerRisk()</t></is></c><c r="C5" t="inlineStr" s="1"><is><t xml:space="preserve">riskTag list</t></is></c><c r="D5" t="inlineStr" s="1"><is><t xml:space="preserve">tagCounts[tag] += 1</t></is></c><c r="E5" t="inlineStr" s="1"><is><t xml:space="preserve">rawChosen</t></is></c><c r="F5" t="inlineStr" s="1"><is><t xml:space="preserve">重复选择同类标签会累加，但后续受 appear 上限约束</t></is></c></row><row r="6" ht="34" customHeight="1"><c r="A6" t="inlineStr" s="1"><is><t xml:space="preserve">5. 有效次数</t></is></c><c r="B6" t="inlineStr" s="1"><is><t xml:space="preserve">calculatePlayerRisk()</t></is></c><c r="C6" t="inlineStr" s="1"><is><t xml:space="preserve">rawChosen, appear</t></is></c><c r="D6" t="inlineStr" s="1"><is><t xml:space="preserve">effectiveChosen = min(rawChosen, appear)</t></is></c><c r="E6" t="inlineStr" s="1"><is><t xml:space="preserve">effectiveChosen</t></is></c><c r="F6" t="inlineStr" s="1"><is><t xml:space="preserve">appear 至少为 1</t></is></c></row><row r="7" ht="34" customHeight="1"><c r="A7" t="inlineStr" s="1"><is><t xml:space="preserve">6. 暴露量</t></is></c><c r="B7" t="inlineStr" s="1"><is><t xml:space="preserve">calculatePlayerRisk()</t></is></c><c r="C7" t="inlineStr" s="1"><is><t xml:space="preserve">effectiveChosen, appear</t></is></c><c r="D7" t="inlineStr" s="1"><is><t xml:space="preserve">exposure = sqrt(effectiveChosen / appear)</t></is></c><c r="E7" t="inlineStr" s="1"><is><t xml:space="preserve">exposure</t></is></c><c r="F7" t="inlineStr" s="1"><is><t xml:space="preserve">用平方根压缩重复选择收益</t></is></c></row><row r="8" ht="34" customHeight="1"><c r="A8" t="inlineStr" s="1"><is><t xml:space="preserve">7. 标签分数</t></is></c><c r="B8" t="inlineStr" s="1"><is><t xml:space="preserve">calculatePlayerRisk()</t></is></c><c r="C8" t="inlineStr" s="1"><is><t xml:space="preserve">exposure, logOR</t></is></c><c r="D8" t="inlineStr" s="1"><is><t xml:space="preserve">score = exposure * logOR</t></is></c><c r="E8" t="inlineStr" s="1"><is><t xml:space="preserve">riskTagCounts[tag].score</t></is></c><c r="F8" t="inlineStr" s="1"><is><t xml:space="preserve">score 按 4 位小数四舍五入展示</t></is></c></row><row r="9" ht="34" customHeight="1"><c r="A9" t="inlineStr" s="1"><is><t xml:space="preserve">8. 四维累加</t></is></c><c r="B9" t="inlineStr" s="1"><is><t xml:space="preserve">calculatePlayerRisk()</t></is></c><c r="C9" t="inlineStr" s="1"><is><t xml:space="preserve">tag score + tag.dimension</t></is></c><c r="D9" t="inlineStr" s="1"><is><t xml:space="preserve">dimensionScores[dimension] += score</t></is></c><c r="E9" t="inlineStr" s="1"><is><t xml:space="preserve">sensory/rhythm/specificity/danger score</t></is></c><c r="F9" t="inlineStr" s="1"><is><t xml:space="preserve">仅四个维度会被累加</t></is></c></row><row r="10" ht="34" customHeight="1"><c r="A10" t="inlineStr" s="1"><is><t xml:space="preserve">9. 总分</t></is></c><c r="B10" t="inlineStr" s="1"><is><t xml:space="preserve">calculatePlayerRisk()</t></is></c><c r="C10" t="inlineStr" s="1"><is><t xml:space="preserve">dimensionScores</t></is></c><c r="D10" t="inlineStr" s="1"><is><t xml:space="preserve">totalScore = sum(dimensionScores)</t></is></c><c r="E10" t="inlineStr" s="1"><is><t xml:space="preserve">totalScore</t></is></c><c r="F10" t="inlineStr" s="1"><is><t xml:space="preserve">按 4 位小数输出</t></is></c></row><row r="11" ht="34" customHeight="1"><c r="A11" t="inlineStr" s="1"><is><t xml:space="preserve">10. 归一化指数</t></is></c><c r="B11" t="inlineStr" s="1"><is><t xml:space="preserve">normalizeRiskIndex()</t></is></c><c r="C11" t="inlineStr" s="1"><is><t xml:space="preserve">score, RISK_MAX</t></is></c><c r="D11" t="inlineStr" s="1"><is><t xml:space="preserve">riskIndex = clamp(0,100,(score/maxScore)*100)</t></is></c><c r="E11" t="inlineStr" s="1"><is><t xml:space="preserve">totalRiskIndex 与四维 riskIndex</t></is></c><c r="F11" t="inlineStr" s="1"><is><t xml:space="preserve">总分用 RISK_MAX.total；四维分别用各自 max</t></is></c></row><row r="12" ht="34" customHeight="1"><c r="A12" t="inlineStr" s="1"><is><t xml:space="preserve">11. 风险等级</t></is></c><c r="B12" t="inlineStr" s="1"><is><t xml:space="preserve">getRiskLevel()</t></is></c><c r="C12" t="inlineStr" s="1"><is><t xml:space="preserve">totalRiskIndex</t></is></c><c r="D12" t="inlineStr" s="1"><is><t xml:space="preserve">&lt;33 low；&gt;=33 且 &lt;42 medium；&gt;=42 high</t></is></c><c r="E12" t="inlineStr" s="1"><is><t xml:space="preserve">riskLevel/riskLevelLabel</t></is></c><c r="F12" t="inlineStr" s="1"><is><t xml:space="preserve">中文标签来自 RISK_LEVEL_LABELS</t></is></c></row><row r="13" ht="50" customHeight="1"><c r="A13" t="inlineStr" s="1"><is><t xml:space="preserve">12. 维度端点</t></is></c><c r="B13" t="inlineStr" s="1"><is><t xml:space="preserve">getDimensionEndpoint()</t></is></c><c r="C13" t="inlineStr" s="1"><is><t xml:space="preserve">dimension riskIndex</t></is></c><c r="D13" t="inlineStr" s="1"><is><t xml:space="preserve">riskIndex &gt;= DIMENSION_ENDPOINT_THRESHOLDS[dimension] ? high : low</t></is></c><c r="E13" t="inlineStr" s="1"><is><t xml:space="preserve">dimensions[dimension].endpoint</t></is></c><c r="F13" t="inlineStr" s="1"><is><t xml:space="preserve">端点阈值：sensory 56、rhythm 43、specificity 51、danger 17</t></is></c></row><row r="14" ht="50" customHeight="1"><c r="A14" t="inlineStr" s="1"><is><t xml:space="preserve">13. 结算人格码</t></is></c><c r="B14" t="inlineStr" s="1"><is><t xml:space="preserve">buildResultPersonaSummary()</t></is></c><c r="C14" t="inlineStr" s="1"><is><t xml:space="preserve">riskResult.dimensions</t></is></c><c r="D14" t="inlineStr" s="1"><is><t xml:space="preserve">每维按 50 阈值生成 L/V、O/D、C/K、A/G；拼接 typeCode；sampleSerial 固定 0127</t></is></c><c r="E14" t="inlineStr" s="1"><is><t xml:space="preserve">playerCode，例如 VDKG-0127</t></is></c><c r="F14" t="inlineStr" s="1"><is><t xml:space="preserve">注意这里的端点阈值是 50，和 riskConfig 的端点阈值不完全一致</t></is></c></row><row r="15" ht="50" customHeight="1"><c r="A15" t="inlineStr" s="1"><is><t xml:space="preserve">14. 百分位</t></is></c><c r="B15" t="inlineStr" s="1"><is><t xml:space="preserve">getResultRiskPercentile()</t></is></c><c r="C15" t="inlineStr" s="1"><is><t xml:space="preserve">totalRiskIndex</t></is></c><c r="D15" t="inlineStr" s="1"><is><t xml:space="preserve">生成 100 个 deterministic simulatedScores；percentile = sampleScore &lt;= 玩家分数 的数量</t></is></c><c r="E15" t="inlineStr" s="1"><is><t xml:space="preserve">percentileText</t></is></c><c r="F15" t="inlineStr" s="1"><is><t xml:space="preserve">展示为“你的饮食风险高于 X% 的用户”</t></is></c></row><row r="16" ht="50" customHeight="1"><c r="A16" t="inlineStr" s="1"><is><t xml:space="preserve">15. 数据分析页 payload</t></is></c><c r="B16" t="inlineStr" s="1"><is><t xml:space="preserve">buildPlanetAtlasPayload()</t></is></c><c r="C16" t="inlineStr" s="1"><is><t xml:space="preserve">playerRiskResult + playerChoices</t></is></c><c r="D16" t="inlineStr" s="1"><is><t xml:space="preserve">收集 selectedChoiceIds、selectedFoodNames 和 player 风险字段，通过 postMessage 发给 iframe</t></is></c><c r="E16" t="inlineStr" s="1"><is><t xml:space="preserve">PLANET_ATLAS_DATA.payload</t></is></c><c r="F16" t="inlineStr" s="1"><is><t xml:space="preserve">省份只记录/展示，不参与当前风险分数计算</t></is></c></row></sheetData><pageMargins left="0.7" right="0.7" top="0.75" bottom="0.75" header="0.3" footer="0.3"/></worksheet>